{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=../CartIQ.Infrastructure/Data/dev.db"
  },
  "FileUpload": {
    "UploadDir": "temp/upload"
  },
  "FileSettings": {
    "MaxSizeInBytes": 10485760,
    "SupportedContentTypes": [
      "application/pdf",
      "image/png",
      "image/jpeg",
      "image/tiff",
      "image/bmp"
    ]
  },
  "CorsSettings": {
    "AllowedOrigins": ["*"],
    "AllowedMethods": ["*"],
    "AllowedHeaders": ["*"]
  }
}
